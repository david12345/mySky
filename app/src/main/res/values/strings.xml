<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">mySky</string>
    <string name="widget_label">mySky — aviões no céu</string>
    <string name="widget_description">Mostra o avião mais visível sobre a tua localização.</string>

    <!-- Widget: os cinco estados (005-sky-widget). Presente e passado são strings **separadas**, e
         não uma frase montada com o verbo interpolado: uma frase feita em pedaços é uma frase que
         alguém pode montar mal. -->
    <string name="widget_no_data_title">Ainda sem dados</string>
    <string name="widget_no_data_detail">A primeira leitura aparece dentro de minutos.</string>
    <string name="widget_permission_title">Falta a localização</string>
    <string name="widget_permission_detail">Toca para abrir a app e dar permissão.</string>
    <string name="widget_empty_fresh_title">Céu livre</string>
    <string name="widget_empty_fresh_detail">Nenhum avião no teu céu · %1$s</string>
    <string name="widget_empty_stale_title">Estava livre</string>
    <string name="widget_empty_stale_detail">Nenhum avião %1$s</string>
    <string name="widget_no_callsign">Aeronave sem indicativo</string>
    <!-- Presente: só quando a observação é recente o bastante para isto ser plausível. -->
    <string name="widget_fresh_detail">%1$d° acima do horizonte · %2$s</string>
    <!-- Passado: um avião atravessa o céu em 4 a 5 minutos. -->
    <string name="widget_stale_detail">Estava a %1$d° %2$s</string>
    <string name="widget_more_flights">+%1$d</string>
    <string name="widget_refresh">Atualizar</string>
    <string name="widget_refreshing">A atualizar…</string>
    <!-- Duas falhas com remédios diferentes: uma resolve-se ligando a rede, a outra só passa amanhã. -->
    <string name="widget_no_connection">Sem ligação</string>
    <string name="widget_rate_limited">Limite diário atingido</string>

    <!-- Notificações de passagem (006) -->
    <string name="notification_channel_name">Aviões por cima</string>
    <string name="notification_channel_description">Aviso quando uma aeronave passa alto sobre a tua localização.</string>
    <string name="notification_no_callsign">Aeronave sem indicativo</string>
    <string name="notification_unknown_airline">companhia desconhecida</string>
    <string name="notification_body">A %1$d° acima do horizonte · %2$s</string>

    <!-- Definições: a secção das notificações -->
    <string name="settings_section_notifications">Notificações</string>
    <string name="settings_notifications_enabled">Avisar-me quando passa um avião</string>
    <string name="settings_notifications_help">Só funciona com o trabalho de fundo ativo. Fica desligado até tu quereres.</string>
    <string name="settings_notification_threshold">Avisar a partir de</string>
    <string name="settings_notification_threshold_help">Quanto mais alto o ângulo, mais raro o aviso — e menos tempo tens para olhar.</string>
    <!-- O número que o utilizador precisa de ver ANTES de ligar, senão conclui que está avariado. -->
    <string name="settings_capture_rate">Com esta configuração, esperas ser avisado de cerca de %1$d%% das passagens.</string>
    <string name="settings_capture_rate_why">O Android só deixa procurar de %1$d em %1$d minutos, e um avião atravessa o teu céu em menos de três. Não há forma de apanhar mais sem gastar a bateria toda.</string>
    <string name="settings_notifications_permission_missing">As notificações estão bloqueadas nas definições do Android.</string>
    <string name="settings_background_location_missing">Falta a permissão de localização em segundo plano. Sem ela, o widget e os avisos não funcionam com a app fechada.</string>
    <string name="settings_open_system_settings">Abrir definições</string>

    <!-- Rationale das permissões: mostrado ANTES do diálogo do sistema. -->
    <string name="permission_location_rationale">Para saber que aviões estão sobre ti, a mySky precisa da tua localização. A posição é usada apenas no teu dispositivo, para calcular a distância e o ângulo até cada avião.</string>
    <string name="permission_background_location_rationale">Para te avisar quando passa um avião mesmo por cima, mesmo com a app fechada, a mySky precisa de aceder à localização em segundo plano. Podes usar a app sem isto — só não recebes notificações com a app fechada.</string>
    <string name="permission_notifications_rationale">Ativa as notificações para seres avisado quando um avião passa sobre a tua localização.</string>

    <!-- ===== Ecrã principal: lista de aviões no céu (feature 001-sky-list) ===== -->

    <!-- Progresso: as duas fases têm de ser distinguíveis (FR-022). -->
    <string name="sky_locating_user">A obter a tua localização…</string>
    <string name="sky_loading_flights">A procurar aviões no teu céu…</string>

    <!-- Céu vazio: sucesso sem resultados, nunca com aspeto de erro (FR-023). -->
    <string name="sky_empty_title">Céu limpo</string>
    <string name="sky_empty_body">Não há nenhum avião a passar sobre ti neste momento. A lista atualiza-se sozinha.</string>

    <!-- Erros: uma mensagem distinta por causa, todas com repetição (FR-024). -->
    <string name="sky_error_no_connection">Sem ligação à Internet. Verifica os dados móveis ou o Wi-Fi.</string>
    <string name="sky_error_service_unavailable">O serviço de voos não respondeu. Tenta de novo dentro de momentos.</string>
    <string name="sky_error_rate_limited">Demasiados pedidos ao serviço de voos. A app volta a tentar dentro de pouco tempo.</string>
    <string name="sky_error_location_unavailable">Não foi possível obter a tua localização. Confirma que o GPS está ligado.</string>
    <string name="sky_error_unexpected">Aconteceu um erro inesperado.</string>
    <string name="sky_error_retry">Tentar de novo</string>

    <!-- Resultados mantidos no ecrã quando a atualização falha (FR-025). -->
    <string name="sky_stale_warning">Estes dados podem estar desatualizados.</string>

    <!-- Permissão de localização (FR-005). O rationale reutiliza permission_location_rationale. -->
    <string name="sky_permission_title">A mySky precisa da tua localização</string>
    <string name="sky_permission_grant">Conceder localização</string>
    <string name="sky_permission_permanently_denied_body">Recusaste a permissão de localização de forma permanente. Podes voltar a concedê-la nas definições do sistema.</string>
    <string name="sky_permission_open_settings">Abrir definições</string>

    <!-- Última atualização (FR-018). -->
    <string name="sky_updated_seconds_ago">há %1$d s</string>
    <string name="sky_updated_minutes_ago">há %1$d min</string>
    <string name="sky_updated_just_now">agora mesmo</string>

